class SendVictim:
    def __init__(self):
        self.victims_detections = {}
        self.sent_victims = set()
        self.reset_time = time.time()
        self.ser = SerialHandler('/dev/serial0', 115200)
        self.ser.config(time.time())
        self.ser.run_serial()
        self.chip = None
        self.pin1 = None
        self.pin2 = None
        self.pin3 = None

    def setup_gpio(self):
        return
        self.chip = gpiod.Chip('gpiochip0')
        self.pin2 = self.chip.get_line(17)
        self.pin3 = self.chip.get_line(22)
        self.pin1 = self.chip.get_line(27)

        self.pin1.request(consumer="myapp", type=gpiod.LINE_REQ_DIR_OUT)
        self.pin2.request(consumer="myapp", type=gpiod.LINE_REQ_DIR_OUT)
        self.pin3.request(consumer="myapp", type=gpiod.LINE_REQ_DIR_OUT)

        self.pin1.set_value(0)
        self.pin2.set_value(0)
        self.pin3.set_value(0)
        
    def reset_input_buffer(self):
        self.ser.reset_input_buffer()

    def write(self, data):
        self.ser.write(str(data).encode())

    def read(self):
        return self.ser.readline().decode('utf-8', errors='ignore').strip()

